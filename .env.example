# =============================================================================
# THE BREAKFAST CLUB — environment variables
# Copy this file to .env.local (local development) and fill in every value.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit .env.local — it is git-ignored.
# =============================================================================

# --- Site --------------------------------------------------------------------
# The public URL of the app, no trailing slash. Used for Stripe/Supabase redirects.
# Local: http://localhost:3000     Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Supabase Dashboard → your project → Project Settings → API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon public" key (legacy) or the "publishable" key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (legacy) or a "secret" key (sb_secret_...). SERVER ONLY — never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (OPTIONAL) -------------------------------------------------------
# Only needed for automatic card payments. Leave all three empty to run the club
# on Zelle / cash only (set your Zelle details in the app under Settings).
# Stripe Dashboard → Developers → API keys → Secret key (sk_test_... in test mode, sk_live_... in live mode)
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
# Locally, use the whsec_... printed by `stripe listen` instead.
STRIPE_WEBHOOK_SECRET=
# OPTIONAL. A recurring monthly Price id (price_...). If empty, Checkout charges the
# "Monthly Membership Fee" from the app's Settings page ($20 by default).
STRIPE_PRICE_ID=

# --- Scheduled reminders -----------------------------------------------------
# Any long random string. Protects /api/cron/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Email (recommended) -----------------------------------------------------
# Send email from a Gmail account (e.g. breakfastclub.dues@gmail.com).
# GMAIL_APP_PASSWORD is a 16-letter "app password", NOT your normal Gmail password:
# Google Account → Security → 2-Step Verification (turn on) → App passwords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Other notification services (optional) ----------------------------------
# Email via Resend instead of Gmail (https://resend.com). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=The Breakfast Club <dues@your-domain.com>
# SMS via Twilio (https://console.twilio.com → Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
